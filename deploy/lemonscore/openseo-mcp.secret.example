# Copy to ~/lemonscore/sites/openseo-mcp.secret on the server (root, 0600) and put
# the token from 1Password ("OpenSEO MCP token (seo.lemon-score.ch)") in place of
# TOKEN. Imported inside the seo.lemon-score.ch site block of openseo.caddy.
# Hex token (no * or spaces): Caddy's header matcher compares it exactly.
@mcp_token {
	path /mcp /mcp/*
	header Authorization "Bearer TOKEN"
}
handle @mcp_token {
	reverse_proxy open-seo:3001
}
